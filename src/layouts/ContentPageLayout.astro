---
import Layout from "./Layout.astro";
import MenuNav from "../components/sections/MenuNav.astro";
import Footer from "../components/sections/Footer.astro";
import { getFooterContent, getNavConfig, getSiteMeta } from "../services/api";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = "Dolci Vita" } = Astro.props;
const [meta, nav, footer] = await Promise.all([
  getSiteMeta(),
  getNavConfig(),
  getFooterContent(),
]);
---

<Layout title={`${title} — Dolci Vita`} description={description}>
  <div class="content-page">
    <MenuNav
      logo={meta.logo}
      logoAlt={meta.logoAlt}
      backHref="/"
      backLabel="Back home"
      cta={nav.cta}
    />
    <main id="main">
      <header class="page-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </header>
      <div class="page-content">
        <slot />
      </div>
    </main>
    <Footer footer={footer} />
  </div>
</Layout>

<style>
  .content-page {
    min-height: 100vh;
    background: var(--cream);
  }

  .page-header {
    padding: clamp(64px, 10vw, 120px) clamp(20px, 5vw, 48px)
      clamp(42px, 6vw, 72px);
    text-align: center;
    background: var(--parchment);
  }

  .page-header > * {
    max-width: 820px;
    margin-inline: auto;
  }

  .eyebrow {
    margin-block: 0 14px;
    color: var(--gold-deep);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1 {
    margin-block: 0 18px;
    font-family: "Cormorant", serif;
    font-size: clamp(46px, 8vw, 78px);
    font-weight: 600;
    line-height: 1;
  }

  .description {
    margin-block: 0;
    color: var(--body-muted);
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.7;
  }

  .page-content {
    width: min(100% - 40px, 960px);
    margin-inline: auto;
    padding-block: clamp(48px, 8vw, 96px);
  }

  .page-content :global(.content-section) {
    margin-block: 0 52px;
  }

  .page-content :global(.content-section:last-child) {
    margin-bottom: 0;
  }

  .page-content :global(h2) {
    margin-block: 0 16px;
    font-family: "Cormorant", serif;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.1;
  }

  .page-content :global(h3) {
    margin-block: 28px 10px;
    font-size: 18px;
  }

  .page-content :global(p),
  .page-content :global(li) {
    color: var(--body-muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .page-content :global(a:focus-visible),
  .page-content :global(button:focus-visible),
  .page-content :global(input:focus-visible),
  .page-content :global(textarea:focus-visible),
  .page-content :global(summary:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .page-content :global(.placeholder-note) {
    padding: 16px 18px;
    border-left: 4px solid var(--gold);
    border-radius: 0 10px 10px 0;
    background: #f4edda;
    color: var(--ink);
  }
</style>
