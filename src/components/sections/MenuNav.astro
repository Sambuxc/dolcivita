---
import Button from "../ui/Button.astro";
import type { CTAButton } from "../../services/types";
import { withBase } from "../../utils/paths";

interface Props {
  logo: string;
  logoAlt: string;
  backHref: string;
  backLabel: string;
  cta: CTAButton;
}

const { logo, logoAlt, backHref, backLabel, cta } = Astro.props;
---

<nav class="menu-nav" aria-label="Menu page">
  <a href={withBase(backHref)} class="back">
    <span class="back-icon" aria-hidden="true">←</span>
    <span class="back-label">{backLabel}</span>
  </a>
  <a href={withBase("/")} class="logo-link">
    <img src={withBase(logo)} alt={logoAlt} class="logo" />
  </a>
  <Button label={cta.label} href={cta.href} variant={cta.variant} size="sm" />
</nav>

<style>
  .menu-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 248, 242, 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid #e6dfce;
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px clamp(16px, 5vw, 48px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 14px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .back:focus-visible,
  .logo-link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .back-icon {
    display: inline-flex;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: rgba(42, 39, 30, 0.06);
    align-items: center;
    justify-content: center;
    transition: transform 0.3s var(--ease);
  }

  .back:hover .back-icon {
    transform: translateX(-3px);
  }

  .logo {
    height: 34px;
    width: auto;
  }

  @media (max-width: 420px) {
    .back-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
