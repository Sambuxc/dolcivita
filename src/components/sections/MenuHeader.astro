---
import Eyebrow from '../ui/Eyebrow.astro';
import type { MenuPageContent } from '../../services/types';

interface Props {
  menu: MenuPageContent;
}

const { menu } = Astro.props;
---
<header class="header">
  <div data-reveal>
    <Eyebrow text={menu.eyebrow} align="center" />
  </div>
  <h1 data-reveal>{menu.titleLead} <em>{menu.titleEmphasis}</em></h1>
  <p data-reveal>{menu.description}</p>
</header>

<style>
  .header {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 110px) clamp(20px, 5vw, 48px) clamp(28px, 4vw, 48px);
    text-align: center;
  }

  h1 {
    font-family: 'Cormorant', serif;
    font-weight: 600;
    font-size: clamp(52px, 10vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 20px 0 22px;
  }

  h1 em {
    font-style: italic;
    color: var(--gold-deep);
  }

  p {
    max-width: 520px;
    margin: 0 auto;
    color: var(--body-muted);
    font-size: 17px;
    line-height: 1.6;
  }
</style>
