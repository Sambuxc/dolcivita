---
import Eyebrow from "../ui/Eyebrow.astro";
import type { StoryContent } from "../../services/types";
import { withBase } from "../../utils/paths";

interface Props {
  story: StoryContent;
}

const { story } = Astro.props;
---

<section id="story" class="story">
  <div class="grid">
    <div class="media-wrap" data-reveal>
      <div class="media">
        <img src={withBase(story.image)} alt={story.imageAlt} loading="lazy" />
      </div>
      <div class="stat">
        <div class="stat-num">{story.stat.value}</div>
        <div class="stat-label">{story.stat.label}</div>
      </div>
    </div>
    <div data-reveal>
      <Eyebrow text={story.eyebrow} tone="bright" />
      <h2>{story.title}</h2>
      {
        story.paragraphs.map((p, i) => (
          <p class:list={[i === 0 ? "lead" : "sub"]}>{p}</p>
        ))
      }
      <a href={withBase(story.link.href)} class="link-arrow"
        >{story.link.label}</a
      >
    </div>
  </div>
</section>

<style>
  .story {
    background: #2a271e;
    color: #f1ebd5;
    overflow: hidden;
  }

  .grid {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(72px, 10vw, 150px) clamp(20px, 5vw, 48px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }

  .media-wrap {
    position: relative;
  }

  .media {
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .stat {
    position: absolute;
    bottom: -26px;
    right: -10px;
    background: var(--gold);
    color: var(--ink);
    padding: 20px 26px;
    border-radius: 16px;
    box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.5);
    max-width: 210px;
  }

  .stat-num {
    font-family: "Cormorant", serif;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
  }

  .stat-label {
    font-size: 12.5px;
    letter-spacing: 0.04em;
    margin-top: 4px;
    font-weight: 500;
  }

  h2 {
    font-family: "Cormorant", serif;
    font-weight: 500;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 20px 0 26px;
  }

  .lead {
    margin: 0 0 18px;
    color: #d8cfb4;
    font-size: 17px;
    line-height: 1.7;
    max-width: 52ch;
  }

  .sub {
    margin: 0 0 34px;
    color: #a9a290;
    font-size: 16px;
    line-height: 1.7;
    max-width: 52ch;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #f1ebd5;
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1.5px solid rgba(241, 235, 213, 0.35);
    padding-bottom: 4px;
    transition: border-color 0.3s var(--ease);
  }

  .link-arrow:hover {
    border-color: var(--gold);
    color: #f1ebd5;
  }

  .link-arrow:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
</style>
