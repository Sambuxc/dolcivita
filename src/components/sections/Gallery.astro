---
import Eyebrow from "../ui/Eyebrow.astro";
import type { GalleryContent } from "../../services/types";
import { withBase } from "../../utils/paths";

interface Props {
  gallery: GalleryContent;
}

const { gallery } = Astro.props;
---

<section id="gallery" class="gallery">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <Eyebrow text={gallery.eyebrow} tone="bright" />
        <h2>{gallery.titleLead}<br /><em>{gallery.titleEmphasis}</em></h2>
      </div>
      <a
        href={gallery.followHref}
        target="_blank"
        rel="noopener"
        class="follow"
      >
        <span class="ig-icon" aria-hidden="true"
          ><span class="ig-dot"></span><span class="ig-corner"></span></span
        >
        {gallery.handle}
      </a>
    </div>

    <div class="masonry">
      {
        gallery.items.map((g) => (
          <a
            data-reveal
            data-tile
            href={withBase(g.link)}
            target="_blank"
            rel="noopener"
            class="tile"
          >
            <img src={withBase(g.img)} alt={g.alt} loading="lazy" />
            <span class="scrim" aria-hidden="true" />
            <span class="handle">{gallery.handle}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    background: #2a271e;
    color: #f1ebd5;
  }

  .wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(72px, 10vw, 140px) clamp(20px, 5vw, 48px);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 60px);
  }

  h2 {
    font-family: "Cormorant", serif;
    font-weight: 600;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 16px 0 0;
  }

  h2 em {
    font-style: italic;
    color: var(--gold-pale);
  }

  .follow {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    background: var(--gold);
    color: var(--ink);
    padding: 14px 26px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    transition:
      transform 0.16s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .follow:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -12px rgba(186, 155, 47, 0.6);
    color: var(--ink);
  }

  .follow:focus-visible {
    outline: 2px solid var(--gold-pale);
    outline-offset: 3px;
  }

  .ig-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    border: 2px solid var(--ink);
    border-radius: 7px;
    position: relative;
  }

  .ig-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border: 2px solid var(--ink);
    border-radius: 999px;
  }

  .ig-corner {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 2.5px;
    height: 2.5px;
    background: var(--ink);
    border-radius: 999px;
  }

  .masonry {
    column-width: 230px;
    column-gap: clamp(12px, 1.4vw, 18px);
  }

  .tile {
    display: block;
    position: relative;
    break-inside: avoid;
    margin-bottom: clamp(12px, 1.4vw, 18px);
    border-radius: 16px;
    overflow: hidden;
    background: #3a362b;
    text-decoration: none;
  }

  .tile:focus-visible {
    outline: 2px solid var(--gold-pale);
    outline-offset: 3px;
  }

  .tile img {
    width: 100%;
    height: auto;
    display: block;
    transition:
      transform 0.7s var(--ease),
      filter 0.5s var(--ease);
    filter: saturate(1.02);
  }

  .tile:hover img {
    transform: scale(1.05);
    filter: saturate(1.12);
  }

  .tile .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 12, 0) 45%,
      rgba(20, 18, 12, 0.6) 100%
    );
    opacity: 0.9;
    pointer-events: none;
  }

  .handle {
    position: absolute;
    left: 14px;
    bottom: 12px;
    z-index: 2;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #f1ebd5;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
</style>
