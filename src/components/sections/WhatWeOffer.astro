---
import Eyebrow from "../ui/Eyebrow.astro";
import type { OfferContent } from "../../services/types";
import { withBase } from "../../utils/paths";

interface Props {
  offer: OfferContent;
}

const { offer } = Astro.props;
---

<section id="offer" class="offer">
  <div class="grid">
    <div class="media" data-reveal>
      <img src={withBase(offer.image)} alt={offer.imageAlt} loading="lazy" />
    </div>
    <div data-reveal>
      <Eyebrow text={offer.eyebrow} />
      <h2>{offer.titleLead}<br /><em>{offer.titleEmphasis}</em></h2>
      <div class="rule"></div>
      {
        offer.paragraphs.map((p, i) => (
          <p class:list={[i === 0 ? "lead" : "sub"]}>
            {p}
            {i === offer.paragraphs.length - 1 && (
              <span class="faint"> {offer.note}</span>
            )}
          </p>
        ))
      }
      <a href={withBase(offer.link.href)} class="link-arrow"
        >{offer.link.label}</a
      >
    </div>
  </div>
</section>

<style>
  .offer {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(64px, 9vw, 130px) clamp(20px, 5vw, 48px)
      clamp(24px, 4vw, 40px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }

  .media {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: 22px;
    overflow: hidden;
    background: #f0ebdd;
    box-shadow: 0 30px 64px -30px rgba(42, 39, 30, 0.4);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h2 {
    font-family: "Cormorant", serif;
    font-weight: 600;
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1.03;
    letter-spacing: -0.015em;
    margin: 16px 0 22px;
  }

  h2 em {
    font-style: italic;
    color: var(--gold-deep);
  }

  .rule {
    width: 64px;
    height: 3px;
    background: var(--gold);
    border-radius: 2px;
    margin: 0 0 26px;
  }

  .lead {
    margin: 0 0 18px;
    color: var(--body-muted);
    font-size: 17px;
    line-height: 1.7;
    max-width: 52ch;
  }

  .sub {
    margin: 0 0 30px;
    color: var(--body-faint);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 52ch;
  }

  .faint {
    opacity: 0.7;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1.5px solid rgba(42, 39, 30, 0.3);
    padding-bottom: 4px;
    transition: border-color 0.3s var(--ease);
  }

  .link-arrow:hover {
    border-color: var(--gold);
    color: var(--ink);
  }

  .link-arrow:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
</style>
