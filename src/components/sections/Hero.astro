---
import Nav from "./Nav.astro";
import Button from "../ui/Button.astro";
import type { HeroContent, NavConfig, SiteMeta } from "../../services/types";
import { withBase } from "../../utils/paths";

interface Props {
  meta: SiteMeta;
  nav: NavConfig;
  hero: HeroContent;
}

const { meta, nav, hero } = Astro.props;
---

<div class="hero" data-hero>
  <div class="slides" data-slides>
    {
      hero.slides.map((slide) =>
        slide.kind === "video" ? (
          <div class="slide" data-slide data-kind="video">
            <video muted loop playsinline preload="auto">
              <source src={withBase(slide.webm)} type="video/webm" />
              <source src={withBase(slide.mp4)} type="video/mp4" />
            </video>
          </div>
        ) : (
          <div class="slide" data-slide data-kind="image">
            <img
              src={withBase(slide.src)}
              alt={slide.alt}
              class="ken"
              style={`transform-origin:${slide.focalOrigin}`}
            />
          </div>
        ),
      )
    }
  </div>
  <div class="scrim"></div>

  <Nav
    logo={meta.logo}
    logoAlt={meta.logoAlt}
    links={nav.links}
    cta={nav.cta}
    variant="overlay"
  />

  <div class="content">
    <span class="eyebrow">{hero.eyebrow}</span>
    <h1>{hero.titleLead}<br /><em>{hero.titleEmphasis}</em></h1>
    <p>{hero.description}</p>
    <div class="ctas">
      <Button
        label={hero.primaryCta.label}
        href={hero.primaryCta.href}
        variant={hero.primaryCta.variant}
        arrow
      />
      <Button
        label={hero.secondaryCta.label}
        href={hero.secondaryCta.href}
        variant={hero.secondaryCta.variant}
      />
    </div>
  </div>

  <div class="dots" data-dots role="tablist" aria-label="Hero slides">
    {
      hero.slides.map((_, i) => (
        <button
          type="button"
          data-dot
          role="tab"
          aria-label={`Slide ${i + 1}`}
          aria-current={i === 0 ? "true" : "false"}
        />
      ))
    }
  </div>
</div>

<script>
  import { initHeroSlideshow } from "../../utils/heroSlideshow";
  const heroEl = document.querySelector<HTMLElement>("[data-hero]");
  if (heroEl) initHeroSlideshow(heroEl);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #2a271e;
  }

  .slides {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.3s var(--ease);
  }

  .slide[data-kind="video"] video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ken {
    animation: dvKen 9s var(--ease) infinite alternate;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 12, 0.62) 0%,
      rgba(20, 18, 12, 0.18) 30%,
      rgba(20, 18, 12, 0.32) 58%,
      rgba(20, 18, 12, 0.9) 100%
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 3;
    margin-top: auto;
    padding: clamp(28px, 4vw, 64px) clamp(24px, 4vw, 60px)
      clamp(48px, 5vw, 72px);
    max-width: 820px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold-pale);
    font-weight: 600;
    margin-bottom: 20px;
    animation: dvRise 0.8s var(--ease) both;
    animation-delay: 0.05s;
  }

  h1 {
    font-family: "Cormorant", serif;
    font-weight: 600;
    font-size: clamp(54px, 7.5vw, 104px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    color: #fdfbf4;
    margin: 0 0 22px;
    animation: dvRise 0.85s var(--ease) both;
    animation-delay: 0.15s;
  }

  h1 em {
    font-style: italic;
    color: var(--gold-pale);
  }

  .content p {
    max-width: 460px;
    color: #e7dfc9;
    font-size: 18px;
    line-height: 1.55;
    margin: 0 0 34px;
    animation: dvRise 0.85s var(--ease) both;
    animation-delay: 0.25s;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    animation: dvRise 0.85s var(--ease) both;
    animation-delay: 0.35s;
  }

  .dots {
    position: absolute;
    z-index: 3;
    right: clamp(24px, 4vw, 60px);
    bottom: clamp(48px, 5vw, 72px);
    display: flex;
    gap: 10px;
  }

  .dots button {
    width: 34px;
    height: 4px;
    border: none;
    padding: 0;
    border-radius: 999px;
    background: rgba(253, 251, 244, 0.32);
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }

  .dots button:focus-visible {
    outline: 2px solid var(--gold-pale);
    outline-offset: 3px;
  }

  .dots button[aria-current="true"] {
    background: rgba(253, 251, 244, 0.9);
  }
</style>
