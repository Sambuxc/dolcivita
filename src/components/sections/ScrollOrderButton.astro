---
import type { CTAButton } from "../../services/types";
import { withBase } from "../../utils/paths";

interface Props {
  cta: CTAButton;
}

const { cta } = Astro.props;
---

<a
  class="scroll-order"
  href={withBase(cta.href)}
  data-scroll-order
  aria-hidden="true"
  tabindex="-1"
>
  {cta.label}
  <span aria-hidden="true">→</span>
</a>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const orderButton = document.querySelector<HTMLAnchorElement>("[data-scroll-order]");

  if (hero && orderButton) {
    const setVisible = (visible: boolean) => {
      orderButton.classList.toggle("is-visible", visible);
      orderButton.setAttribute("aria-hidden", String(!visible));
      orderButton.tabIndex = visible ? 0 : -1;
    };

    const observer = new IntersectionObserver(
      ([entry]) => setVisible(!entry.isIntersecting && entry.boundingClientRect.bottom <= 0),
      { threshold: 0 },
    );

    observer.observe(hero);
  }
</script>

<style>
  .scroll-order {
    position: fixed;
    right: clamp(16px, 3vw, 36px);
    bottom: clamp(16px, 3vw, 34px);
    z-index: 55;
    padding: 14px 22px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(42, 39, 30, 0.16);
    border-radius: 999px;
    background: var(--gold);
    box-shadow: 0 16px 36px -16px rgba(42, 39, 30, 0.65);
    color: var(--ink);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
    transition:
      opacity 0.28s var(--ease),
      transform 0.28s var(--ease),
      visibility 0s linear 0.28s;
  }

  .scroll-order.is-visible {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
    animation: gentlePulse 0.75s ease-in-out 0.3s 2;
    transition-delay: 0s;
  }

  .scroll-order:hover {
    color: var(--ink);
    transform: translateY(-2px);
  }

  .scroll-order:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @keyframes gentlePulse {
    0%,
    100% {
      box-shadow: 0 16px 36px -16px rgba(42, 39, 30, 0.65);
      filter: brightness(1);
    }
    50% {
      box-shadow:
        0 16px 36px -14px rgba(42, 39, 30, 0.7),
        0 0 0 7px rgba(186, 155, 47, 0.2);
      filter: brightness(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-order,
    .scroll-order.is-visible {
      animation: none;
      transition: none;
    }
  }
</style>
