---
import ContentPageLayout from "../../layouts/ContentPageLayout.astro";
import Pill from "../../components/ui/Pill.astro";
import { getMenuPageContent, getSiteMeta } from "../../services/api";
import type { MenuItem } from "../../services/types";
import { productSlug } from "../../utils/productSlug";
import { withBase } from "../../utils/paths";

export async function getStaticPaths() {
  const menu = await getMenuPageContent();

  return menu.items.map((item) => ({
    params: { slug: productSlug(item) },
    props: { item },
  }));
}

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
const meta = await getSiteMeta();
---

<ContentPageLayout
  title={item.name}
  description={`${item.desc} ${item.price}. View product information and order from Dolci Vita.`}
  eyebrow={item.cat}
>
  <article class="product">
    <div class="product-media">
      {item.img ? (
        <img src={withBase(item.img)} alt={item.alt} />
      ) : (
        <div class="image-placeholder" role="img" aria-label={`Product photograph of ${item.name} coming soon`}>
          Product photograph coming soon
        </div>
      )}
    </div>

    <div class="product-details">
      <div class="price-row">
        <p class="price">{item.price}</p>
        {item.badge && <Pill text={item.badge} variant="badge" />}
      </div>
      <p class="description">{item.desc}</p>
      <div class="tags" aria-label="Product labels">
        <Pill text={item.cat} variant="category" />
        {item.diet.map((label) => <Pill text={label} variant="diet" />)}
      </div>
      <div class="allergen-note">
        <h2>Dietary and allergen information</h2>
        <p>Product-specific allergen information is awaiting confirmation. Please speak to the team before ordering if you have an allergy or dietary requirement.</p>
      </div>
      <div class="actions">
        <a class="order" href={meta.phoneHref}>Call to order</a>
        <a class="back" href={withBase("/menu")}>Back to the full menu</a>
      </div>
    </div>
  </article>
</ContentPageLayout>

<style>
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(34px, 7vw, 80px);
    align-items: start;
  }

  .product-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 22px;
    background: var(--parchment);
  }

  .product-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    padding: 28px;
    display: grid;
    place-items: center;
    color: var(--body-faint);
    text-align: center;
  }

  .price-row,
  .tags,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .price-row {
    justify-content: space-between;
  }

  .price {
    margin: 0;
    color: var(--gold-deep);
    font-family: "Cormorant", serif;
    font-size: 36px;
    font-weight: 700;
  }

  .description {
    margin-block: 16px 20px;
    color: var(--body-muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .allergen-note {
    margin-block: 30px;
    padding: 20px;
    border-radius: 14px;
    background: var(--parchment);
  }

  .allergen-note h2 {
    margin: 0 0 8px;
    font-family: inherit;
    font-size: 16px;
  }

  .allergen-note p {
    margin: 0;
    font-size: 14px;
  }

  .order,
  .back {
    padding: 14px 22px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .order {
    background: var(--gold);
    color: var(--ink);
  }

  .back {
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  @media (max-width: 700px) {
    .product {
      grid-template-columns: 1fr;
    }
  }
</style>
